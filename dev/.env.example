# =============================================================================
# dev/.env — Langflow + AI service configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Docker Compose loads the copied `.env` file for variable interpolation.
# The real .env is gitignored — never commit secrets.
# =============================================================================

# --- Single-origin nginx harness --------------------------------------------
# Local default: http://localhost:8080
# Cloudflare example: https://intercept.example.com
INTERCEPT_PORT=8080
INTERCEPT_PUBLIC_ORIGIN=http://localhost:8080
INTERCEPT_TRUSTED_HOSTS=["localhost","127.0.0.1"]
# Dedicated nginx-to-backend bridge. Override if this subnet collides locally;
# do not replace it with a broad RFC 1918 range.
INTERCEPT_INGRESS_SUBNET=172.31.250.0/24
# Set true whenever INTERCEPT_PUBLIC_ORIGIN uses HTTPS.
SESSION_COOKIE_SECURE=false
# Durable concurrent MCP authorization capacity per validated client source.
MCP_OAUTH_PENDING_AUTHORIZATION_PER_SOURCE_QUOTA=50
# Cross-worker Argon2 capacity. Keep the lease comfortably above the slowest
# observed password verification/change/reset runtime under CPU pressure.
PASSWORD_HASH_MAX_CONCURRENT=8
PASSWORD_HASH_LEASE_SECONDS=900

# --- Local development credentials -----------------------------------------
# These defaults are for loopback-only development. Rotate every value before
# making the harness externally reachable, including through a tunnel.
POSTGRES_PASSWORD=intercept_password
LANGFLOW_DB_PASSWORD=langflow_password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
LANGFLOW_SUPERUSER_PASSWORD=admin
LANGFLOW_SECRET_KEY=3R1HFctPJZ_MDJg-GQe2Z_TaEyZyXQZtbcCR5l8S0E4=
SECRET_KEY=dev-secret-key-change-in-production
INITIAL_ADMIN_PASSWORD=Dev-initial-admin-password1!

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=

# --- Opik (observability) ---------------------------------------------------
OPIK_API_KEY=
OPIK_URL_OVERRIDE=https://www.comet.com/opik/api
OPIK_PROJECT_NAME=LangflowIntercept
OPIK_WORKSPACE=

# --- Langflow feature flags -------------------------------------------------
LANGFLOW_API_KEY=dev-langflow-api-key
LANGFLOW_MCP_SERVER_ENABLED=false
LANGFLOW_ADD_PROJECTS_TO_MCP_SERVERS=false
