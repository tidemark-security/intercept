# =============================================================================
# Tidemark Intercept — Instance Configuration
# =============================================================================
# Copy to .env:  cp .env.example .env
#
# The quickstart installer (install.sh) generates this automatically.
# If setting up manually, generate secrets with:
#   openssl rand -base64 32 | tr -d '/+=' | head -c 24    (for passwords)
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  (for SECRET_KEY)
# =============================================================================

# --- Secrets (required) ------------------------------------------------------
POSTGRES_PASSWORD=<generate>
LANGFLOW_DB_PASSWORD=<generate>
SECRET_KEY=<generate-fernet-key>
MINIO_ROOT_USER=<generate>
MINIO_ROOT_PASSWORD=<generate>

# --- Langflow auth (required) ------------------------------------------------
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=<generate>
LANGFLOW_SECRET_KEY=<generate>
LANGFLOW_API_KEY=<generate>

# --- Image version (optional) ------------------------------------------------
# TAG=0.1.0

# --- Public Intercept origin / MCP OAuth (optional) --------------------------
# docker-compose.yml enables MCP browser auth and derives its OAuth URLs from
# this externally reachable origin. Use HTTPS for non-loopback deployments.
# INTERCEPT_PUBLIC_ORIGIN=http://localhost
# Set this to true whenever INTERCEPT_PUBLIC_ORIGIN uses HTTPS so browsers only
# send authentication cookies over encrypted connections.
# SESSION_COOKIE_SECURE=true
# JSON host allowlist; set this alongside a non-local public origin.
# INTERCEPT_TRUSTED_HOSTS=["localhost","127.0.0.1"]
# Dedicated frontend-to-backend bridge. Override only to avoid a local subnet
# collision; do not broaden this to an entire RFC 1918 range.
# INTERCEPT_INGRESS_SUBNET=172.31.251.0/24
# Durable concurrent MCP authorization capacity per validated client source.
# MCP_OAUTH_PENDING_AUTHORIZATION_PER_SOURCE_QUOTA=50
# Cross-worker Argon2 capacity. The lease is crash recovery, so keep it well
# above the worst-case password verification/change/reset runtime.
# PASSWORD_HASH_MAX_CONCURRENT=8
# PASSWORD_HASH_LEASE_SECONDS=900

# --- AI features (optional) --------------------------------------------------
# Get an API key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# --- Opik observability (optional) -------------------------------------------
# OPIK_API_KEY=
# OPIK_URL_OVERRIDE=https://www.comet.com/opik/api
# OPIK_PROJECT_NAME=LangflowIntercept
# OPIK_WORKSPACE=
