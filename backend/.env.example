# Environment Configuration
DATABASE_URL=postgresql+asyncpg://intercept_user:intercept_password@localhost:5432/intercept_case_db

# Application Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production

# Logging
LOG_LEVEL=INFO

# Session Management
SESSION_COOKIE_NAME=intercept_session
SESSION_COOKIE_SECURE=false  # Set to true in production with HTTPS
SESSION_IDLE_TIMEOUT_HOURS=12
SESSION_SECRET_KEY=replace-with-long-random-value
RESET_TOKEN_EXPIRY_MINUTES=30

# Object Storage Configuration (MinIO/S3)
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=intercept-attachments
STORAGE_USE_SSL=false  # Set to true in production
STORAGE_REGION=us-east-1
STORAGE_AUTO_CREATE_BUCKET=true

# AWS S3 example:
# STORAGE_ENDPOINT=s3.ap-southeast-2.amazonaws.com
# STORAGE_REGION=ap-southeast-2
# STORAGE_USE_SSL=true
# STORAGE_BUCKET=your-intercept-attachments-bucket
# STORAGE_AUTO_CREATE_BUCKET=false
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# File Upload Validation
# Allowed/denied MIME types are settings-registry keys (storage.allowed_file_types /
# storage.denied_file_types) — manage them via the admin settings UI, or override
# here as JSON arrays:
# ALLOWED_FILE_TYPES=["image/png", "application/pdf", "message/rfc822"]
# DENIED_FILE_TYPES=["text/html", "image/svg+xml", "application/xhtml+xml"]
MAX_UPLOAD_SIZE_MB=5000

# Presigned URL Expiration
UPLOAD_TIMEOUT_MINUTES=60
DOWNLOAD_TIMEOUT_MINUTES=30
