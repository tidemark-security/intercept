FROM golang:1.27.4-trixie AS gosu

WORKDIR /src

# The upstream PostgreSQL image bundles gosu compiled with an older Go release.
RUN git clone --depth 1 --branch 1.20 https://github.com/tianon/gosu.git . \
    && go get golang.org/x/sys@v0.50.0 \
    && CGO_ENABLED=0 go build -mod=mod -trimpath -o /gosu .

FROM docker.io/library/postgres:18.7-trixie

COPY --from=gosu /gosu /usr/local/bin/gosu

# Install the PostgreSQL 18 extensions from the image's PGDG repository.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    postgresql-18-cron \
    postgresql-18-pgvector \
    && rm -rf /var/lib/apt/lists/*

# Note: extension initialization is performed by init.sql mounted via dev/docker-compose.yml
# or inlined via configs in docs/quickstart/docker-compose.yml
USER postgres
